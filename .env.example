# FasalBima Sathi - LLM Configuration Example
# Copy this file to .env and set your active API key.
# IMPORTANT: Never commit the .env file to Git!

# Selected provider: "groq" or "gemini" (leave empty to auto-detect from keys)
LLM_PROVIDER=groq

# Groq API Settings (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Settings (https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

